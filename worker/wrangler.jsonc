{
  // Darwin Beach: serves the page (web/dist) and the trainer's files (R2 bucket arena-data).
  // Not deployed yet: that is Daniel's call. See README.md.
  "name": "darwin-beach",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // The page. The Worker runs first on every request so it can strip the /darwin-beach prefix
  // and answer data/* from R2; everything else goes to env.ASSETS.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // The only data binding: the bucket the uploader writes to (tools/upload.py --r2).
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "arena-data" }],

  // The path this Worker is mounted at on play.thegoodface.ai. Stripped when present, so it
  // works whether or not the play Worker strips it first.
  "vars": { "BASE_PATH": "/darwin-beach" },

  // No route here: the play Worker reaches us through a service binding.
  "workers_dev": false,
  "preview_urls": false
}
